# Datenbank (Neon Postgres Connection String)
DATABASE_URL=

# Session-Signierung: mindestens 32 zufällige Zeichen, z.B. mit
# `openssl rand -hex 32` erzeugen. NIE committen, NIE wiederverwenden.
SESSION_SECRET=

# Resend (Transaktions- und Newsletter-Mails)
RESEND_API_KEY=

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
# Aus Stripe Dashboard -> Developers -> Webhooks -> Endpoint anlegen
# (Ziel-URL: https://deine-domain.de/api/stripe-webhook) -> Signing Secret
STRIPE_WEBHOOK_SECRET=

# Web Push (siehe Abschlussbericht für die generierten Werte)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@email.de

# Pusher (Realtime für den internen Team-Chat unter /chat) - kostenlosen
# "Channels"-App im Pusher-Dashboard anlegen: https://dashboard.pusher.com/
# Cluster z.B. "eu" - steht im Dashboard direkt neben den Keys.
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Basis-URL der Seite (für Links in Emails, Stripe Redirects, etc.)
NEXT_PUBLIC_BASE_URL=https://mz-dev.de
NEXT_PUBLIC_SITE_URL=https://mz-dev.de

# Vercel Blob (Produktbilder) - wird automatisch gesetzt, sobald im Vercel
# Dashboard unter "Storage" ein Blob-Store mit dem Projekt verbunden wird.
# BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (Bot-Schutz auf Login/Registrierung/Passwort-
# vergessen) - kostenlos unter https://dash.cloudflare.com -> Turnstile.
# Ohne diese beiden Variablen läuft die Seite normal weiter, nur eben
# (noch) ohne Bot-Schutz (siehe app/utils/turnstile.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Native Push-Notifications für die Mobile App (Capacitor, siehe
# MOBILE_APP_SETUP.md) - kompletter Inhalt der Firebase-Service-Account-
# JSON-Datei als ein-Zeilen-String. Ohne diese Variable läuft die App
# normal, nur eben ohne native Push-Benachrichtigungen (Web Push im
# Browser funktioniert davon unabhängig weiter).
FIREBASE_SERVICE_ACCOUNT_JSON=
